rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── PROYECTOS ──────────────────────────────────────────────────────────
    match /proyectos/{proyectoId} {
      // Leer: cualquier usuario autenticado
      // (la seguridad real está en los listeners que solo traen proyectos propios/compartidos)
      allow read: if request.auth != null;
      // Crear (setDoc con doc nuevo): autenticado. No se exige ownerId propio: la regla es
      // de antes del rediseño de equipos y nada lo necesitó cerrar.
      allow create: if request.auth != null;
      // Editar (rediseño de equipos; desde el paso 6 solo con `miembros`, sin las ramas del
      // sistema viejo: equipos, `compartidoCon`, solicitudes):
      allow update: if request.auth != null && (
        // El dueño, todo.
        resource.data.ownerId == request.auth.uid ||
        // El EDITOR cambia el proyecto, salvo quién es el dueño y quiénes son miembros: eso
        // lo hacen el dueño y el servidor.
        (
          resource.data.get('miembros', {}).get(request.auth.uid, {}).get('rol', '') == 'editor' &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'miembros', 'miembrosUids', 'compartidoCon', 'permisos'])
        ) ||
        // Cualquier MIEMBRO puede salirse: se quita de miembros y de miembrosUids, sin tocar a
        // nadie más ni nada más. (Los campos viejos siguen en la lista para que un teléfono
        // sin actualizar, que todavía los limpia al salir, pueda salirse igual.)
        (
          request.auth.uid in resource.data.get('miembrosUids', []) &&
          !(request.auth.uid in request.resource.data.get('miembrosUids', [])) &&
          !(request.auth.uid in request.resource.data.get('miembros', {})) &&
          request.resource.data.get('miembros', {}).diff(resource.data.get('miembros', {})).affectedKeys().hasOnly([request.auth.uid]) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['miembros', 'miembrosUids', 'compartidoCon', 'permisos', 'supervisoresInfo', 'enListaDe'])
        ) ||
        // Cualquier MIEMBRO pone al día SU nombre y empresa en `miembros` (cuando cambia su
        // configuración; antes iban a `supervisoresInfo`). Nada más: ni su rol.
        (
          request.auth.uid in resource.data.get('miembrosUids', []) &&
          request.auth.uid in resource.data.get('miembros', {}) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['miembros']) &&
          request.resource.data.miembros.diff(resource.data.miembros).affectedKeys().hasOnly([request.auth.uid]) &&
          request.resource.data.miembros[request.auth.uid].diff(resource.data.miembros[request.auth.uid]).affectedKeys().hasOnly(['nombre', 'empresa'])
        )
      );
      // Borrar: solo el dueño
      allow delete: if request.auth != null &&
        resource.data.ownerId == request.auth.uid;
    }

    // ── FOTOS DE PROYECTO (subcollección) ─────────────────────────────────
    match /proyectos/{proyectoId}/fotosProyecto/{fotoId} {
      allow read: if request.auth != null && (
        esDuenoDelProyecto(proyectoId, request.auth.uid) ||
        esColaboradorDelProyecto(proyectoId, request.auth.uid)
      );
      allow create: if request.auth != null && (
        esDuenoDelProyecto(proyectoId, request.auth.uid) ||
        esEditorDelProyecto(proyectoId, request.auth.uid)
      );
      // Quien la subió la quita, mientras siga siendo editor (paso 6: el supervisor no
      // borra nada).
      allow delete: if request.auth != null && (
        esDuenoDelProyecto(proyectoId, request.auth.uid) ||
        (resource.data.uid == request.auth.uid && esEditorDelProyecto(proyectoId, request.auth.uid))
      );
    }

    // ── DISEÑO ────────────────────────────────────────────────────────────
    // Capas de la proyección de la red (catastro, red, meta). Las ve cualquiera
    // que pueda ver el proyecto, pero solo las escribe el dueño: el diseño es el
    // compromiso contra el que después se liquida la obra.
    match /proyectos/{proyectoId}/diseno/{capaId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && esDuenoDelProyecto(proyectoId, request.auth.uid);
    }

    // ── PUNTOS ────────────────────────────────────────────────────────────
    // Paso 6 del rediseño de equipos: los cambian solo el dueño y los editores de SU
    // obra; el supervisor solo mira (ver editaLaObra, abajo). Leer sigue abierto: las
    // consultas de la app no cambian. Al cambiar un punto se mira la obra de antes y la
    // de después (mover a otra obra exige poder editar las dos).
    match /puntos/{puntoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && editaLaObra(request.resource.data);
      allow update: if request.auth != null && editaLaObra(resource.data) && editaLaObra(request.resource.data);
      allow delete: if request.auth != null && editaLaObra(resource.data);
    }

    // ── CONEXIONES (FIBRAS) ───────────────────────────────────────────────
    match /conexiones/{conexionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && editaLaObra(request.resource.data);
      allow update: if request.auth != null && editaLaObra(resource.data) && editaLaObra(request.resource.data);
      allow delete: if request.auth != null && editaLaObra(resource.data);
    }

    // ── CABLES DE ACERO ───────────────────────────────────────────────────
    // Mensajero de poste a poste; se liquida como ferretería, por metro. Mismas
    // reglas que las fibras.
    match /cablesAcero/{cableId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && editaLaObra(request.resource.data);
      allow update: if request.auth != null && editaLaObra(resource.data) && editaLaObra(request.resource.data);
      allow delete: if request.auth != null && editaLaObra(resource.data);
    }

    // ── BITÁCORA ──────────────────────────────────────────────────────────
    match /bitacora/{mensajeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        resource.data.autorUid == request.auth.uid;
    }

    // ── CONFIGURACIONES ───────────────────────────────────────────────────
    match /configuraciones/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── USUARIOS ──────────────────────────────────────────────────────────
    // Cerrada en el paso 6 del rediseño (antes cualquiera leía y escribía todo, incluidos
    // los dispositivos autorizados de los demás). El id es el correo. Cada uno lee SOLO su
    // documento (la app lo lee al entrar: dispositivos, perfil, permisos) y cambia solo su
    // logo; dispositivos, perfil y permisos los maneja el admin, y crearUsuario escribe
    // con el SDK de admin. El correo se compara en minúsculas.
    match /usuarios/{userId} {
      allow read: if request.auth != null && (esAdmin() || esMiUsuario(userId));
      allow create: if request.auth != null && (esAdmin() ||
        (esMiUsuario(userId) && request.resource.data.keys().hasOnly(['logoEmpresa', 'logoEmpresaBase64'])));
      allow update: if request.auth != null && (esAdmin() ||
        (esMiUsuario(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['logoEmpresa', 'logoEmpresaBase64'])));
      allow delete: if request.auth != null && esAdmin();
    }

    // ── EXPORTACIONES ─────────────────────────────────────────────────────
    match /exportaciones/{exportId} {
      allow read, write: if request.auth != null;
    }

    // (EQUIPOS: la colección se borró en el paso 6, con respaldo en `respaldoPaso6Equipos`,
    // que solo lee el servidor. Sin regla, nadie la lee ni la escribe desde la app.)

    // ── INVITACIONES A UN PROYECTO (rediseño de equipos, paso 3a) ─────────
    // El link o el QR llevan solo el código (el id de este documento, largo y al azar);
    // el proyecto y el rol viven aquí, donde nadie los puede cambiar a mano. Aceptar lo
    // hace la función `aceptarInvitacion`, con el SDK de admin: nadie puede sumarse a
    // un proyecto escribiendo desde el cliente.
    match /invitaciones/{codigo} {
      // Se lee de a una, con el código: así se muestra antes de aceptarla, sin poder
      // listar las de otros.
      allow get: if request.auth != null;
      // Quien las creó las lista (la consulta tiene que filtrar por deUid).
      allow list: if request.auth != null && resource.data.deUid == request.auth.uid;
      // Solo el dueño del proyecto invita, a editor o a supervisor, y nacen abiertas.
      allow create: if request.auth != null
        && request.resource.data.deUid == request.auth.uid
        && request.resource.data.estado == 'abierta'
        && request.resource.data.rol in ['editor', 'supervisor']
        && request.resource.data.tipo in ['link', 'qr']
        && get(/databases/$(database)/documents/proyectos/$(request.resource.data.proyectoId)).data.ownerId == request.auth.uid;
      // Quien la creó la anula (link) o la cierra (QR). No se puede cambiar nada más.
      allow update: if request.auth != null
        && resource.data.deUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'anuladaEn'])
        && request.resource.data.estado in ['anulada', 'cerrada'];
    }

    // ── AMISTADES (rediseño de equipos, paso 3b) ──────────────────────────
    // Un documento por pareja; el id son los dos uids ordenados, unidos por "_". Mutua y
    // con consentimiento: uno la pide, y solo el otro puede aceptarla.
    match /amistades/{par} {
      // Solo la ven los dos (la consulta tiene que filtrar por uids array-contains).
      allow read: if request.auth != null && request.auth.uid in resource.data.uids;
      allow create: if request.auth != null
        && request.resource.data.de == request.auth.uid
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.uids.size() == 2
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.para in request.resource.data.uids
        && request.resource.data.para != request.auth.uid
        && par == request.resource.data.uids[0] + '_' + request.resource.data.uids[1];
      // Aceptar: solo quien la recibió, y solo el estado, la fecha y su propio nombre.
      allow update: if request.auth != null
        && resource.data.para == request.auth.uid
        && resource.data.estado == 'pendiente'
        && request.resource.data.estado == 'aceptada'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'aceptadaEn', 'nombres']);
      // Rechazar, cancelar o dejar de ser amigos: cualquiera de los dos.
      allow delete: if request.auth != null && request.auth.uid in resource.data.uids;
    }

    // ── AVISOS (rediseño de equipos, paso 3b) ─────────────────────────────
    // "Fulano te agregó a su proyecto". Solo el dueño de ese proyecto puede crearlo, y
    // solo quien lo recibe lo lee y lo marca como visto.
    match /avisos/{id} {
      allow read: if request.auth != null && resource.data.para == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.deUid == request.auth.uid
        && request.resource.data.visto == false
        && get(/databases/$(database)/documents/proyectos/$(request.resource.data.proyectoId)).data.ownerId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.para == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visto', 'vistoEn']);
    }

    // ── CONTROL DE FERRETERÍA ─────────────────────────────────────────────
    match /controlFerreteria/{listaId} {
      // Leer: cualquier autenticado — los EDITORES de un proyecto de equipo necesitan
      // la lista de control del dueño para generar la liquidación de materiales.
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // ── ERRORES ───────────────────────────────────────────────────────────
    match /errores/{errorId} {
      allow create: if request.auth != null;
      allow read, delete: if request.auth != null &&
        request.auth.token.email == 'eduardo.valdivia84@gmail.com';
    }

    // ── SISTEMA (config global) — ferretería base: lee cualquiera, escribe solo admin ──
    match /sistema/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == 'E8CaZVgP4eZnjnN3OKTVi7bmoJN2';
    }

    // ── VERIFICACIÓN DE FOTOS (resultado permanente por proyecto) ─────────
    match /verificacionesFotos/{proyectoId} {
      allow read, write: if request.auth != null;
    }

    // ── PAPELERA (soft-delete, 15 días) ───────────────────────────────────
    // La papelera POR PROYECTO la ven todos (lo borrado del proyecto, por cualquiera),
    // pero mandar algo a la papelera o sacarlo (recuperar) es de quien edita la obra
    // (paso 6). La purga de los 15 días la hace el servidor, que no pasa por aquí.
    match /papelera/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid &&
        editaLaObra(request.resource.data);
      allow update, delete: if request.auth != null && editaLaObra(resource.data);
    }

    // ── FUNCIONES AUXILIARES ──────────────────────────────────────────────
    // El admin, por uid o por correo (los mismos que usan `sistema` y `errores`)
    function esAdmin() {
      return request.auth.uid == 'E8CaZVgP4eZnjnN3OKTVi7bmoJN2' ||
        request.auth.token.get('email', '') == 'eduardo.valdivia84@gmail.com';
    }

    // El documento de `usuarios` de quien pide (el id es su correo)
    function esMiUsuario(userId) {
      return request.auth.token.get('email', '') != '' &&
        request.auth.token.get('email', '').lower() == userId.lower();
    }

    // ── Rol por obra (paso 6) para puntos, fibras, acero y papelera ──
    // `d` es el documento (el de antes o el de después). Lo cambia quien edita su obra: el
    // dueño o un editor de `miembros`. El admin, siempre (sus herramientas de soporte).
    // Sin obra conocida —puntos viejos sin proyectoId, o que quedaron de una obra que ya no
    // existe— queda como antes: cualquier autenticado. (Al borrar una obra, su lote se
    // evalúa con la obra todavía en pie: pasa por ser el dueño.) El proyectoId numérico de
    // los puntos viejos se compara como texto.
    // Cada obra se lee UNA vez (get, que da null si no existe; sin exists aparte): Firestore
    // permite 20 lecturas por lote y cuenta una sola vez la misma obra repetida. Probado en
    // el emulador: 450 postes de una obra en un lote pasan; más de 20 obras distintas, no.
    function obraDe(d) {
      return /databases/$(database)/documents/proyectos/$(string(d.proyectoId));
    }

    function sinObra(d) {
      return d.get('proyectoId', null) == null || string(d.proyectoId) == '' || get(obraDe(d)) == null;
    }

    function editaEn(p) {
      return p.get('ownerId', '') == request.auth.uid ||
        p.get('miembros', {}).get(request.auth.uid, {}).get('rol', '') in ['dueno', 'editor'];
    }

    function editaLaObra(d) {
      return esAdmin() || sinObra(d) || editaEn(get(obraDe(d)).data);
    }

    function esDuenoDelProyecto(proyectoId, uid) {
      return exists(/databases/$(database)/documents/proyectos/$(proyectoId)) &&
        get(/databases/$(database)/documents/proyectos/$(proyectoId)).data.ownerId == uid;
    }

    // Colaborador: miembro del proyecto (`miembrosUids`; desde el paso 6, sin `compartidoCon`)
    function esColaboradorDelProyecto(proyectoId, uid) {
      return exists(/databases/$(database)/documents/proyectos/$(proyectoId)) &&
        uid in get(/databases/$(database)/documents/proyectos/$(proyectoId)).data.get('miembrosUids', []);
    }

    // Editor: rol 'editor' en `miembros` (desde el paso 6, sin `compartidoCon` + `permisos`)
    function esEditorDelProyecto(proyectoId, uid) {
      return exists(/databases/$(database)/documents/proyectos/$(proyectoId)) &&
        get(/databases/$(database)/documents/proyectos/$(proyectoId)).data.get('miembros', {}).get(uid, {}).get('rol', '') == 'editor';
    }
  }
}
