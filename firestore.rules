rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── PROYECTOS ──────────────────────────────────────────────────────────
    match /proyectos/{proyectoId} {
      // Leer: cualquier usuario autenticado
      // (la seguridad real está en los listeners que solo traen proyectos propios/compartidos)
      allow read: if request.auth != null;
      // Crear (setDoc con doc nuevo): autenticado.
      // Permite ownerId propio (creación normal) o ajeno (copia al salir de equipo;
      // consistente con puntos/conexiones que permiten create a cualquier autenticado).
      allow create: if request.auth != null;
      // Editar: dueño, editor, miembro del EQUIPO del proyecto (rol a nivel equipo:
      // puede auto-agregarse como editor al presionar EDITAR en el grupo), solicitud
      // pendiente, o auto-eliminarse de compartidoCon
      allow update: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        (
          resource.data.get('grupoId', '') != '' &&
          exists(/databases/$(database)/documents/equipos/$(resource.data.grupoId)) &&
          request.auth.uid in get(/databases/$(database)/documents/equipos/$(resource.data.grupoId)).data.get('miembrosUids', [])
        ) ||
        (
          request.auth.uid in resource.data.get('compartidoCon', []) &&
          (resource.data.get('permisos', {})[request.auth.uid] == 'edicion' ||
           resource.data.get('permisos', {})[request.auth.uid] == 'ambos')
        ) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['solicitudesPendientes']) ||
        (
          // Auto-eliminarse de compartidoCon (con o sin limpiar permisos)
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['compartidoCon']) &&
          request.auth.uid in resource.data.get('compartidoCon', []) &&
          !(request.auth.uid in request.resource.data.get('compartidoCon', []))
        )
      );
      // Borrar: solo el dueño
      allow delete: if request.auth != null &&
        resource.data.ownerId == request.auth.uid;
    }

    // ── FOTOS DE PROYECTO (subcollección) ─────────────────────────────────
    match /proyectos/{proyectoId}/fotosProyecto/{fotoId} {
      allow read: if request.auth != null && (
        esDuenoDelProyecto(proyectoId, request.auth.uid) ||
        esColaboradorDelProyecto(proyectoId, request.auth.uid)
      );
      allow create: if request.auth != null && (
        esDuenoDelProyecto(proyectoId, request.auth.uid) ||
        esEditorDelProyecto(proyectoId, request.auth.uid)
      );
      allow delete: if request.auth != null && (
        esDuenoDelProyecto(proyectoId, request.auth.uid) ||
        (resource.data.uid == request.auth.uid)
      );
    }

    // ── PUNTOS ────────────────────────────────────────────────────────────
    match /puntos/{puntoId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      // Borrar: cualquier usuario autenticado (consistente con create/update, que ya están
      // abiertos). La regla estricta anterior fallaba con puntos viejos (proyectoId numérico /
      // sin ownerId) y no aportaba seguridad real porque editar ya está abierto.
      allow delete: if request.auth != null;
    }

    // ── CONEXIONES (FIBRAS) ───────────────────────────────────────────────
    match /conexiones/{conexionId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      // Borrar: cualquier usuario autenticado (consistente con create/update).
      allow delete: if request.auth != null;
    }

    // ── BITÁCORA ──────────────────────────────────────────────────────────
    match /bitacora/{mensajeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        resource.data.autorUid == request.auth.uid;
    }

    // ── CONFIGURACIONES ───────────────────────────────────────────────────
    match /configuraciones/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── USUARIOS ──────────────────────────────────────────────────────────
    match /usuarios/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── EXPORTACIONES ─────────────────────────────────────────────────────
    match /exportaciones/{exportId} {
      allow read, write: if request.auth != null;
    }

    // ── EQUIPOS ───────────────────────────────────────────────────────────
    match /equipos/{equipoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        // Solicitar ingreso (agrega a pendientes)
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendientes', 'pendientesUids']) ||
        // Auto-eliminarse del equipo (miembro sale, puede también agregar proyectosHuerfanos)
        (
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['miembros', 'miembrosUids']) &&
          request.auth.uid in resource.data.get('miembrosUids', []) &&
          !(request.auth.uid in request.resource.data.get('miembrosUids', []))
        )
      );
      allow delete: if request.auth != null &&
        resource.data.ownerId == request.auth.uid;
    }

    // ── CONTROL DE FERRETERÍA ─────────────────────────────────────────────
    match /controlFerreteria/{listaId} {
      // Leer: cualquier autenticado — los EDITORES de un proyecto de equipo necesitan
      // la lista de control del dueño para generar la liquidación de materiales.
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // ── ERRORES ───────────────────────────────────────────────────────────
    match /errores/{errorId} {
      allow create: if request.auth != null;
      allow read, delete: if request.auth != null &&
        request.auth.token.email == 'eduardo.valdivia84@gmail.com';
    }

    // ── SISTEMA (config global) — ferretería base: lee cualquiera, escribe solo admin ──
    match /sistema/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == 'E8CaZVgP4eZnjnN3OKTVi7bmoJN2';
    }

    // ── VERIFICACIÓN DE FOTOS (resultado permanente por proyecto) ─────────
    match /verificacionesFotos/{proyectoId} {
      allow read, write: if request.auth != null;
    }

    // ── PAPELERA (soft-delete, 15 días) ───────────────────────────────────
    // Lectura/restauración abierta a autenticados: la papelera POR PROYECTO la ven
    // el creador Y los editores (todo lo borrado del proyecto, por cualquiera).
    match /papelera/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if request.auth != null;
    }

    // ── FUNCIONES AUXILIARES ──────────────────────────────────────────────
    function esDuenoDelProyecto(proyectoId, uid) {
      return exists(/databases/$(database)/documents/proyectos/$(proyectoId)) &&
        get(/databases/$(database)/documents/proyectos/$(proyectoId)).data.ownerId == uid;
    }

    function esColaboradorDelProyecto(proyectoId, uid) {
      return exists(/databases/$(database)/documents/proyectos/$(proyectoId)) &&
        uid in get(/databases/$(database)/documents/proyectos/$(proyectoId)).data.get('compartidoCon', []);
    }

    function esEditorDelProyecto(proyectoId, uid) {
      let proyecto = get(/databases/$(database)/documents/proyectos/$(proyectoId)).data;
      let permiso = proyecto.get('permisos', {})[uid];
      return exists(/databases/$(database)/documents/proyectos/$(proyectoId)) &&
        uid in proyecto.get('compartidoCon', []) &&
        (permiso == 'edicion' || permiso == 'ambos');
    }
  }
}
